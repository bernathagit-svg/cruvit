{
  "kind": "cruvit-climate-object-storage-contract-v1",
  "preferredBackend": "cloudflare-r2",
  "immutablePathPattern": "climate/global-v1/{globalBakeId}/tiles/{tileFileName}",
  "cacheControl": "public, max-age=31536000, immutable",
  "uploadStatus": "PARTIAL_CANARY_DEPLOYED",
  "runtimeFetchStatus": "ACTIVE_PARTIAL_COVERAGE",
  "requiredEnvironment": [
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET"
  ],
  "optionalEnvironment": [
    "R2_ENDPOINT",
    "R2_PREFIX"
  ],
  "blockerWhenMissing": "GLOBAL_STORAGE_CONNECTION_REQUIRED",
  "notes": "R2 transport is configured and canary objects are live. Full validated 61,964-tile corpus was built locally but has not yet been fully deployed to R2. Missing remote tiles remain UNKNOWN and must never be converted to inferred hard frost. Full deployment: scripts/coordinate-climate-v2-upload-r2.mjs upload-full.",
  "coverageReadinessAuthority": "climate/global-v1/{globalBakeId}/deployment-manifest.json",
  "globalReadyRule": "GLOBAL_READY only when deployment-manifest.globalReady=true and verifiedRemoteTileCount===expectedLandTileCount"
}
