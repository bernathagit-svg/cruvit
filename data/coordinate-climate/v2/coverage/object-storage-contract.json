{
  "kind": "cruvit-climate-object-storage-contract-v1",
  "preferredBackend": "cloudflare-r2",
  "immutablePathPattern": "climate/global-v1/{globalBakeId}/tiles/{tileFileName}",
  "cacheControl": "public, max-age=31536000, immutable",
  "uploadStatus": "NOT_CONNECTED",
  "requiredEnvironment": [
    "R2_ACCOUNT_ID",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "R2_BUCKET"
  ],
  "optionalEnvironment": ["R2_ENDPOINT", "R2_PREFIX"],
  "blockerWhenMissing": "GLOBAL_STORAGE_CONNECTION_REQUIRED",
  "notes": "Do not commit secrets. Upload script: scripts/coordinate-climate-v2-upload-r2.mjs"
}
