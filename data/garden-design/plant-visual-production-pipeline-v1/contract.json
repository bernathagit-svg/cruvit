{
  "version": "plant-visual-production-pipeline-v1",
  "implementedAt": "2026-09-21",
  "goal": "Every canonical plant can progress through a complete visual production path, including image generation, QA, sizing, promotion, and Garden Design activation.",
  "stages": [
    "canonical-identity",
    "required-visual-states",
    "coverage-gap-detection",
    "quality-and-prompt-planning",
    "owner-spend-envelope",
    "image-generation",
    "technical-qa",
    "framing-qa",
    "botanical-identity-qa",
    "state-and-architecture-qa",
    "in-garden-qa",
    "presentation-sizing",
    "promotion-gate",
    "immutable-publish",
    "registry-activation"
  ],
  "invariants": {
    "generateOnLookup": false,
    "generateOnRender": false,
    "sourceResolutionPreserved": true,
    "productionApprovedRequired": true,
    "silentBinaryReplacementForbidden": true,
    "ownerWorkloadTarget": "exceptions-only",
    "autoApprovalDefault": false,
    "missingOrFailedAsset": "honest-placeholder"
  },
  "qa": {
    "technical": [
      "decode",
      "alpha",
      "dimensions",
      "bbox",
      "crop",
      "edge-contact",
      "coverage",
      "halo"
    ],
    "framing": [
      "top-padding",
      "side-padding",
      "bottom-padding",
      "subject-size-in-canvas"
    ],
    "garden": [
      "perspective",
      "ground-contact",
      "sticker-look",
      "halo",
      "sharpness-match",
      "color-tonal-match",
      "scale-realism",
      "silhouette"
    ]
  },
  "sizing": {
    "authorityOrder": [
      "trusted-physical-size-authority",
      "presentation-sizing-v1",
      "owner-user-scale-adjustment"
    ],
    "baselineInputs": [
      "visualForm",
      "width",
      "height",
      "alphaBBox"
    ],
    "canonicalSlugSwitchesForbidden": true
  },
  "currentRuntimeAssets": [
    "olive",
    "mango",
    "banana",
    "pineapple"
  ],
  "nextScaleStep": "Run dry-run coverage/gap report over canonical catalog, then approve a bounded paid wave for missing high-priority plants."
}
